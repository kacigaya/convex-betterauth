# Created by `bunx convex dev`; public values used by Next.js.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Enable the Google button only when both Google credentials exist on Convex.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Private auth, email, and OAuth values belong in the Convex deployment
# environment. Do not add them to this Next.js environment file.
#
# Local email testing with Resend's onboarding sender can deliver only to the
# email address associated with your Resend account. Production needs a sender
# on a verified Resend domain.
#
# bunx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
# bunx convex env set SITE_URL http://localhost:3000
# bunx convex env set RESEND_API_KEY your-resend-api-key
# bunx convex env set EMAIL_FROM 'Convex Better Auth <onboarding@resend.dev>'
# bunx convex env set GOOGLE_CLIENT_ID your-client-id
# bunx convex env set GOOGLE_CLIENT_SECRET your-client-secret
